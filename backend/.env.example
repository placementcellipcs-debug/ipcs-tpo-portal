# Primary sender accounts and their Apps Script deployments.
# Use a separate Apps Script deployment for each account, executed as that account.
PLACEMENT_EMAIL=placementcell.ipcs@gmail.com
PLACEMENT_APP_PASSWORD=
PLACEMENT_APPS_SCRIPT_URL=
PLACEMENT_APPS_SCRIPT_SECRET=

COMPANY_EMAIL=corporate.ipcs@gmail.com
COMPANY_APP_PASSWORD=
COMPANY_APPS_SCRIPT_URL=
COMPANY_APPS_SCRIPT_SECRET=

INTERVIEW_EMAIL=interview.ipcs@gmail.com
INTERVIEW_APP_PASSWORD=
INTERVIEW_APPS_SCRIPT_URL=
INTERVIEW_APPS_SCRIPT_SECRET=

PORTAL_EMAIL=portal.ipcs@gmail.com
PORTAL_APP_PASSWORD=
PORTAL_APPS_SCRIPT_URL=
PORTAL_APPS_SCRIPT_SECRET=

# Shared sender used if any primary account is unavailable or quota limited.
FALLBACK_EMAIL=giftyipcsglobal@gmail.com
FALLBACK_APP_PASSWORD=
FALLBACK_APPS_SCRIPT_URL=
FALLBACK_APPS_SCRIPT_SECRET=

# Conservative portal-wide account cap, counted by recipient across To/CC/BCC
# in a rolling 24-hour window. Apps Script also returns Google's live quota.
MAIL_ACCOUNT_DAILY_RECIPIENT_CAP=100
MAIL_USAGE_SHEET=EmailQuotaUsage

# Mail usage dashboard and scheduled reports. The dashboard refreshes every 30 minutes.
# Reports go to Gifty by default; override the recipients in Render if needed.
MAIL_DASHBOARD_REFRESH_MINUTES=30
MAIL_REPORTS_ENABLED=true
MAIL_REPORT_RECIPIENTS=giftyipcsglobal@gmail.com
MAIL_REPORT_CATEGORY=placement
MAIL_REPORT_DAILY_CRON=15 8 * * *
MAIL_REPORT_MONTHLY_CRON=30 8 1 * *
MAIL_REPORT_YEARLY_CRON=0 9 1 1 *

# Persistent retry queue in the portal's Google spreadsheet.
MAIL_QUEUE_SHEET=EmailQueue
MAIL_RETRY_BASE_SECONDS=60
MAIL_QUOTA_RETRY_SECONDS=3600
MAIL_MAX_ATTEMPTS=8
MAIL_WORKER_INTERVAL_MS=15000
# Set a stable 32+ character key. If blank, queue encryption derives from
# AUTH_SESSION_SECRET or GOOGLE_PRIVATE_KEY; do not rotate while queued mail exists.
MAIL_QUEUE_ENCRYPTION_KEY=
# Optional private Drive folder for queue messages larger than one Google Sheets cell.
MAIL_QUEUE_DRIVE_FOLDER_ID=
