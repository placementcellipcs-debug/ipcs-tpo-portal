# Primary sender accounts and their Apps Script deployments.
# Use a separate Apps Script deployment for each account, executed as that account.
PLACEMENT_EMAIL=placementcell.ipcs@gmail.com
PLACEMENT_APP_PASSWORD=
PLACEMENT_APPS_SCRIPT_URL=
PLACEMENT_APPS_SCRIPT_SECRET=

COMPANY_EMAIL=corporate.ipcs@gmail.com
COMPANY_APP_PASSWORD=
COMPANY_APPS_SCRIPT_URL=
COMPANY_APPS_SCRIPT_SECRET=

INTERVIEW_EMAIL=interview.ipcs@gmail.com
INTERVIEW_APP_PASSWORD=
INTERVIEW_APPS_SCRIPT_URL=
INTERVIEW_APPS_SCRIPT_SECRET=

PORTAL_EMAIL=portal.ipcs@gmail.com
PORTAL_APP_PASSWORD=
PORTAL_APPS_SCRIPT_URL=
PORTAL_APPS_SCRIPT_SECRET=

# Shared sender used if any primary account is unavailable or quota limited.
FALLBACK_EMAIL=giftyipcsglobal@gmail.com
FALLBACK_APP_PASSWORD=
FALLBACK_APPS_SCRIPT_URL=
FALLBACK_APPS_SCRIPT_SECRET=

# Conservative portal-wide account cap, counted by recipient across To/CC/BCC
# in a rolling 24-hour window. Apps Script also returns Google's live quota.
MAIL_ACCOUNT_DAILY_RECIPIENT_CAP=100
MAIL_USAGE_SHEET=EmailQuotaUsage

# Mail usage dashboard and scheduled reports. The dashboard refreshes every 30 minutes.
# Reports go to Gifty by default; override the recipients in Render if needed.
MAIL_DASHBOARD_REFRESH_MINUTES=30
MAIL_REPORTS_ENABLED=true
MAIL_REPORT_RECIPIENTS=gifty@ipcsglobal.com
MAIL_REPORT_CATEGORY=placement
MAIL_REPORT_DAILY_CRON=15 8 * * *
MAIL_REPORT_MONTHLY_CRON=30 8 1 * *
MAIL_REPORT_YEARLY_CRON=0 9 1 1 *

# Persistent retry queue in the portal's Google spreadsheet.
MAIL_QUEUE_SHEET=EmailQueue
MAIL_RETRY_BASE_SECONDS=60
MAIL_QUOTA_RETRY_SECONDS=3600
MAIL_MAX_ATTEMPTS=8
MAIL_WORKER_INTERVAL_MS=15000
# Set a stable 32+ character key before enabling MYSQL_EMAIL_ENABLED. Do not
# rotate it while queued messages exist; MySQL mode does not use Google secrets as a fallback.
MAIL_QUEUE_ENCRYPTION_KEY=
# Optional private Drive folder for queue messages larger than one Google Sheets cell.
MAIL_QUEUE_DRIVE_FOLDER_ID=

# Add only exact browser origins that should call this API. The built-in list
# already includes the production portals and local development URLs.
CORS_ALLOWED_ORIGINS=

# Asset workbook rebuilt for the portal. Keep the old workbook configured only
# as a read-only migration source; the app copies recognized asset tabs once.
ASSET_SPREADSHEET_ID=1rSinOxDvXjYlkJJUeqdLngP_iUGCa1I0vduOf8DtJFE
ASSET_LEGACY_SPREADSHEET_ID=17tEo324Xyfc3ku98hmsnKZDry4OgCt_hnUlK8hGtVXA

# In production, run mail/cron jobs on one backend instance only. Multiple
# worker-enabled replicas can race because Sheets does not provide an atomic
# queue-claim operation. Resume catch-up starts at 08:15 Asia/Kolkata after a
# restart; scheduled resume delivery runs at 08:00 Asia/Kolkata.
PORTAL_SERVICE_ROLE=all

# Shared MySQL connection for the local staged migration.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=ipcs_portal
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=true
MYSQL_ENABLED=false
# Uses MySQL-only staff sign-in and live session/status checks when enabled.
MYSQL_TPO_AUTH_ENABLED=false
# Uses MySQL-only staff account management and profile photos. Requires the
# shared MySQL tables and MySQL TPO authentication; keep off until checked locally.
MYSQL_TPO_USER_MANAGEMENT_ENABLED=false
# Moves email queue state, quotas, attempts, and delivery history to MySQL.
# Scheduled email reports remain paused until their report builder is migrated.
MYSQL_EMAIL_ENABLED=false
# When enabled, these endpoints use MySQL only and do not fall back to Sheets.
MYSQL_PLACEMENT_TRACKER_ENABLED=false
MYSQL_VACANCY_MANAGEMENT_ENABLED=false
# Uses the shared drives table for the TPO event calendar and status changes.
# Talentino schedule and attendance still require their separate migration.
MYSQL_TPO_EVENTS_ENABLED=false
# Shared student leave history and TPO review. Set consistently in both backends.
MYSQL_STUDENT_LEAVE_ENABLED=false
# Shared Student/TPO issue register. Enable together in both APIs after local checks.
MYSQL_SUPPORT_ISSUES_ENABLED=false
